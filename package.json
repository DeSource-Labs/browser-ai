{
  "name": "browser-ai-kit",
  "description": "Production-ready framework libraries for Chrome built-in AI and WebMCP.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "DeSource Labs <hello@desource-labs.org>",
  "homepage": "https://ai.desource-labs.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/browser-ai.git"
  },
  "bugs": {
    "url": "https://github.com/DeSource-Labs/browser-ai/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -w -r --filter \"./packages/**\" --stream run build",
    "clean": "pnpm -w -r --filter \"./packages/**\" --stream run clean",
    "dev:demo": "pnpm build && pnpm --filter demo dev",
    "dev:prepare": "pnpm --filter demo deps:prepare",
    "build:demo": "pnpm --filter demo build",
    "vercel-build": "pnpm clean && pnpm build && pnpm dev:prepare && pnpm build:demo",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "pnpm clean && pnpm build && changeset publish",
    "release": "pnpm changeset:version && pnpm changeset:publish",
    "lint": "eslint .",
    "test": "pnpm --filter @desource/browser-ai-vue test",
    "typecheck": "pnpm --filter @desource/browser-ai-vue typecheck && pnpm --filter demo deps:prepare && pnpm --filter demo exec nuxt typecheck",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm build && pnpm build:demo",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,md}\"",
    "format:check": "prettier --check \"**/*.{vue,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,md}\""
  },
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "~8.0.16",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  }
}

{
  "name": "@desource/browser-ai-vue",
  "version": "0.2.0",
  "author": "Stefan Popov <stefan@desource-labs.org>",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./assets/lib.css": "./dist/browser-ai-vue.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "pnpm build-lib && pnpm build-types && pnpm postbuild",
    "build-lib": "vite build",
    "build-types": "rimraf dist/types tsconfig.tsbuildinfo && vue-tsc --emitDeclarationOnly --declaration -p tsconfig.json",
    "postbuild": "node scripts/fix-dts.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "vue-tsc": "^3.2.7",
    "vue": "^3.5.33"
  },
  "dependencies": {
    "@types/dom-chromium-ai": "^0.0.16"
  },
  "peerDependencies": {
    "vue": "^3.4.33"
  }
}

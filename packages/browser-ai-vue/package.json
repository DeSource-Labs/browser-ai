{
  "name": "@desource/browser-ai-vue",
  "version": "0.2.0",
  "description": "Production-ready Vue components and composables for Chrome built-in AI and WebMCP.",
  "keywords": [
    "vue",
    "chrome",
    "built-in-ai",
    "gemini-nano",
    "prompt-api",
    "webmcp",
    "on-device-ai",
    "local-ai"
  ],
  "author": "DeSource Labs <hello@desource-labs.org>",
  "license": "MIT",
  "homepage": "https://ai.desource-labs.org/docs#vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/browser-ai.git",
    "directory": "packages/browser-ai-vue"
  },
  "bugs": {
    "url": "https://github.com/DeSource-Labs/browser-ai/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./assets/lib.css": "./dist/browser-ai-vue.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo test-results coverage",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:internal",
    "build:internal": "pnpm build:lib && pnpm build:types",
    "build:lib": "vite build",
    "build:types": "vue-tsc -p tsconfig.json",
    "postbuild": "node scripts/fix-dts.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test:e2e": "sleep 100",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "@types/dom-chromium-ai": "^0.0.17",
    "markdown-it": "^14.3.0",
    "webmcp-types": "^0.1.2"
  },
  "peerDependencies": {
    "vue": "^3.4.33"
  }
}

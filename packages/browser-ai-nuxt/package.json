{
  "name": "@desource/browser-ai-nuxt",
  "version": "0.2.0",
  "description": "Zero-config Nuxt module for Chrome built-in AI and WebMCP, powered by Browser AI Kit.",
  "keywords": [
    "nuxt",
    "vue",
    "chrome",
    "built-in-ai",
    "gemini-nano",
    "prompt-api",
    "webmcp",
    "on-device-ai"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "author": "DeSource Labs <hello@desource-labs.org>",
  "license": "MIT",
  "homepage": "https://ai.desource-labs.org/docs#nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/browser-ai.git",
    "directory": "packages/browser-ai-nuxt"
  },
  "bugs": {
    "url": "https://github.com/DeSource-Labs/browser-ai/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "clean": "rimraf dist .nuxt",
    "build:internal": "pnpm dev:prepare && nuxt-module-build build",
    "build": "pnpm clean && pnpm build:internal"
  },
  "peerDependencies": {
    "nuxt": "^3.17.0 || ^4.0.0",
    "vue": "^3.4.33"
  },
  "dependencies": {
    "@desource/browser-ai-vue": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.4.8",
    "@nuxt/module-builder": "^1.0.2",
    "nuxt": "^4.4.8",
    "vue": "^3.5.39"
  }
}

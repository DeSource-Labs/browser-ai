{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": { "analytics": false },
  "projects": {
    "demo": {
      "projectType": "application",
      "root": "demo",
      "sourceRoot": "demo/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "demo/dist",
            "index": "demo/src/index.html",
            "browser": "demo/src/main.ts",
            "tsConfig": "demo/tsconfig.app.json",
            "styles": ["demo/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "650kB" }]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "headers": {
              "Origin-Agent-Cluster": "?1",
              "Permissions-Policy": "tools=(self)"
            }
          },
          "configurations": {
            "development": { "buildTarget": "demo:build:development" },
            "production": { "buildTarget": "demo:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
